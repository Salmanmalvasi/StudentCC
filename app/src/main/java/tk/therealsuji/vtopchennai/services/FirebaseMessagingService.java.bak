package tk.therealsuji.vtopchennai.services;

import android.app.NotificationChannel;
import android.app.NotificationManager;
import android.app.PendingIntent;
import android.content.Context;
import android.content.Intent;
import android.media.RingtoneManager;
import android.net.Uri;
import android.os.Build;
import android.util.Log;

import androidx.annotation.NonNull;
import androidx.core.app.NotificationCompat;

import com.google.firebase.messaging.RemoteMessage;

import java.util.Map;

import tk.therealsuji.vtopchennai.R;
import tk.therealsuji.vtopchennai.activities.MainActivity;
import tk.therealsuji.vtopchennai.helpers.FirebaseHelper;
import tk.therealsuji.vtopchennai.helpers.InAppMessageManager;
import tk.therealsuji.vtopchennai.helpers.SettingsRepository;

/**
 * Firebase Cloud Messaging Service
 * Handles incoming messages and notifications
 */
public class FirebaseMessagingService extends com.google.firebase.messaging.FirebaseMessagingService {
    private static final String TAG = "FCMService";
    private static final String CHANNEL_ID = "studentcc_notifications";

    @Override
    public void onCreate() {
        super.onCreate();
        createNotificationChannel();
    }

    @Override
    public void onMessageReceived(@NonNull RemoteMessage remoteMessage) {
        Log.d(TAG, "From: " + remoteMessage.getFrom());

        // Check if message contains a data payload
        if (remoteMessage.getData().size() > 0) {
            Log.d(TAG, "Message data payload: " + remoteMessage.getData());
            handleDataMessage(remoteMessage.getData());
        }

        // Check if message contains a notification payload
        if (remoteMessage.getNotification() != null) {
            Log.d(TAG, "Message Notification Body: " + remoteMessage.getNotification().getBody());
            handleNotificationMessage(remoteMessage);
        }
    }

    @Override
    public void onNewToken(@NonNull String token) {
        Log.d(TAG, "Refreshed token: " + token);

        // Save the new token
        SettingsRepository.getSharedPreferences(this)
                .edit()
                .putString("fcm_token", token)
                .apply();

        // Send token to server if needed
        sendTokenToServer(token);
    }

    /**
     * Handle data messages (background/foreground)
     */
    private void handleDataMessage(Map<String, String> data) {
        String messageType = data.get("type");
        String title = data.get("title");
        String body = data.get("body");
        String action = data.get("action");

        if (messageType != null) {
            switch (messageType) {
                case "in_app_message":
                    // Handle in-app message
                    handleInAppMessage(data);
                    break;
                case "system_notification":
                    // Handle system notification
                    sendNotification(title, body, action, data);
                    break;
                case "silent_data":
                    // Handle silent data updates
                    handleSilentData(data);
                    break;
                default:
                    // Default notification
                    sendNotification(title, body, action, data);
                    break;
            }
        } else {
            // Fallback notification
            sendNotification(title, body, action, data);
        }
    }

    /**
     * Handle notification messages (foreground only)
     */
    private void handleNotificationMessage(RemoteMessage remoteMessage) {
        RemoteMessage.Notification notification = remoteMessage.getNotification();
        Map<String, String> data = remoteMessage.getData();

        sendNotification(
            notification.getTitle(),
            notification.getBody(),
            data.get("action"),
            data
        );
    }

    /**
     * Handle in-app messages
     */
    private void handleInAppMessage(Map<String, String> data) {
        String title = data.get("title");
        String message = data.get("message");
        String imageUrl = data.get("image_url");
        String actionUrl = data.get("action_url");
        String messageId = data.get("message_id");
        String priority = data.get("priority");

        // Store in-app message for display
        InAppMessageManager.getInstance().addMessage(
            messageId,
            title,
            message,
            imageUrl,
            actionUrl,
            priority
        );

        // Send broadcast to update UI if app is in foreground
        Intent intent = new Intent("NEW_IN_APP_MESSAGE");
        intent.putExtra("message_id", messageId);
        sendBroadcast(intent);
    }

    /**
     * Handle silent data updates
     */
    private void handleSilentData(Map<String, String> data) {
        String updateType = data.get("update_type");
        
        if ("force_sync".equals(updateType)) {
            // Trigger background sync
            Intent syncIntent = new Intent("FORCE_BACKGROUND_SYNC");
            sendBroadcast(syncIntent);
        } else if ("clear_cache".equals(updateType)) {
            // Clear app cache
            Intent clearIntent = new Intent("CLEAR_APP_CACHE");
            sendBroadcast(clearIntent);
        }
    }

    /**
     * Create and show a simple notification containing the received FCM message
     */
    private void sendNotification(String title, String messageBody, String action, Map<String, String> data) {
        Intent intent = new Intent(this, MainActivity.class);
        intent.addFlags(Intent.FLAG_ACTIVITY_CLEAR_TOP);

        // Add custom action if specified
        if (action != null) {
            intent.putExtra("fcm_action", action);
            for (Map.Entry<String, String> entry : data.entrySet()) {
                intent.putExtra("fcm_" + entry.getKey(), entry.getValue());
            }
        }

        PendingIntent pendingIntent = PendingIntent.getActivity(
            this, 
            0, 
            intent, 
            PendingIntent.FLAG_ONE_SHOT | PendingIntent.FLAG_IMMUTABLE
        );

        Uri defaultSoundUri = RingtoneManager.getDefaultUri(RingtoneManager.TYPE_NOTIFICATION);
        
        NotificationCompat.Builder notificationBuilder =
                new NotificationCompat.Builder(this, CHANNEL_ID)
                        .setSmallIcon(R.drawable.ic_notification)
                        .setContentTitle(title != null ? title : getString(R.string.app_name))
                        .setContentText(messageBody)
                        .setAutoCancel(true)
                        .setSound(defaultSoundUri)
                        .setContentIntent(pendingIntent)
                        .setPriority(NotificationCompat.PRIORITY_HIGH);

        NotificationManager notificationManager =
                (NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE);

        // Generate unique notification ID
        int notificationId = (int) System.currentTimeMillis();
        notificationManager.notify(notificationId, notificationBuilder.build());

        // Log analytics event
        FirebaseHelper.getInstance().logEvent("notification_received", "type", data.get("type"));
    }

    /**
     * Send token to your server
     */
    private void sendTokenToServer(String token) {
        // Implement your server API call here
        Log.d(TAG, "Sending token to server: " + token);
        
        // You can use Retrofit or any HTTP client to send token to your backend
        // Example: YourApiService.sendFCMToken(token);
    }

    /**
     * Create notification channel for Android O and above
     */
    private void createNotificationChannel() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            CharSequence name = getString(R.string.app_name);
            String description = "StudentCC Notifications";
            int importance = NotificationManager.IMPORTANCE_HIGH;
            NotificationChannel channel = new NotificationChannel(CHANNEL_ID, name, importance);
            channel.setDescription(description);

            NotificationManager notificationManager = getSystemService(NotificationManager.class);
            notificationManager.createNotificationChannel(channel);
        }
    }
}
