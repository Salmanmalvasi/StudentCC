<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".fragments.FacultyDetailsFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_faculty"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:elevation="0dp"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/faculty_details"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

        <androidx.appcompat.widget.SearchView
            android:id="@+id/search_view_faculty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/background_search_view"
            app:iconifiedByDefault="false"
            app:queryHint="Search faculty..." />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_show_favorites"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:checkable="true"
            android:text="@string/chip_show_favorites" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- RecyclerView directly without NestedScrollView for better performance -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_faculty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            android:visibility="gone"
            tools:listitem="@layout/item_faculty" />

        <ProgressBar
            android:id="@+id/progress_bar_faculty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="100dp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/text_view_empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="100dp"
            android:drawablePadding="16dp"
            android:gravity="center"
            android:text="@string/no_faculty_found"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            app:drawableTopCompat="@drawable/ic_staff" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
