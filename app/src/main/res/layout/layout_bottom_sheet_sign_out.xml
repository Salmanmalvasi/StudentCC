<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/m3_expressive_spacing_lg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/m3_expressive_spacing_lg"
        android:paddingTop="@dimen/m3_expressive_spacing_lg"
        android:paddingEnd="@dimen/m3_expressive_spacing_lg"
        android:paddingBottom="@dimen/m3_expressive_spacing_md"
        android:text="@string/sign_out"
        android:textAppearance="@style/TextAppearance.M3.Expressive.TitleLarge" />

    <TextView
        android:id="@+id/text_view_sign_out_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="@dimen/m3_expressive_spacing_xl"
        android:paddingTop="@dimen/m3_expressive_spacing_md"
        android:paddingEnd="@dimen/m3_expressive_spacing_xl"
        android:paddingBottom="@dimen/m3_expressive_spacing_md"
        android:text="@string/sign_out_app"
        android:textAppearance="@style/TextAppearance.M3.Expressive.BodyLarge" />
</LinearLayout>
