<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:titleTextColor="?attr/colorOnSurface" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Material You Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/material_you_card"
                style="@style/Widget.M3.Expressive.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/m3_expressive_spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/m3_expressive_spacing_md">

                    <!-- Material You Icon -->
                    <FrameLayout
                        android:layout_width="@dimen/m3_expressive_min_touch_target"
                        android:layout_height="@dimen/m3_expressive_min_touch_target"
                        android:layout_marginEnd="@dimen/m3_expressive_spacing_md">

                        <ImageView
                            android:id="@+id/material_you_icon"
                            android:layout_width="@dimen/m3_expressive_icon_size_large"
                            android:layout_height="@dimen/m3_expressive_icon_size_large"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_material_you_badge_stateful"
                            android:padding="6dp"
                            android:src="@drawable/ic_palette"
                            android:tint="@color/material_you_icon_tint"
                            android:contentDescription="Material You icon" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Material You"
                            android:textAppearance="@style/TextAppearance.M3.Expressive.TitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/material_you_description"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dynamic colors from wallpaper (Android 12+)"
                            android:textAppearance="@style/TextAppearance.M3.Expressive.BodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginTop="@dimen/m3_expressive_spacing_xs" />

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/material_you_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:enabled="true" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- AMOLED Mode Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/amoled_card"
                style="@style/Widget.M3.Expressive.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/m3_expressive_spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/m3_expressive_spacing_md">

                    <!-- AMOLED Icon -->
                    <FrameLayout
                        android:layout_width="@dimen/m3_expressive_min_touch_target"
                        android:layout_height="@dimen/m3_expressive_min_touch_target"
                        android:layout_marginEnd="@dimen/m3_expressive_spacing_md">

                        <ImageView
                            android:id="@+id/amoled_icon"
                            android:layout_width="@dimen/m3_expressive_icon_size_large"
                            android:layout_height="@dimen/m3_expressive_icon_size_large"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_material_you_badge_stateful"
                            android:padding="6dp"
                            android:src="@drawable/ic_amoled"
                            android:tint="@color/material_you_icon_tint"
                            android:contentDescription="AMOLED icon" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AMOLED Mode"
                            android:textAppearance="@style/TextAppearance.M3.Expressive.TitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pure black background for OLED screens"
                            android:textAppearance="@style/TextAppearance.M3.Expressive.BodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginTop="@dimen/m3_expressive_spacing_xs" />

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/amoled_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Color Themes Section Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Color Themes"
                android:textAppearance="@style/TextAppearance.M3.Expressive.TitleLarge"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="@dimen/m3_expressive_spacing_md" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/theme_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
