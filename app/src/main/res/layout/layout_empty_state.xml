<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/m3_expressive_spacing_lg"
    android:layout_marginEnd="@dimen/m3_expressive_spacing_lg"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/text_view_no_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/m3_expressive_spacing_lg"
        android:text="@string/no_data"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.M3.Expressive.HeadlineSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:drawableTopCompat="@drawable/image_no_data" />

    <Button
        android:id="@+id/button"
        style="@style/Widget.M3.Expressive.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/m3_expressive_spacing_lg"
        android:textAllCaps="true"
        android:visibility="gone" />
</LinearLayout>
